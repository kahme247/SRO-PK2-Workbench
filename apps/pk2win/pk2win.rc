#include <windows.h>
#include "resource.h"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...", IDM_FILE_OPEN
        MENUITEM "&Close", IDM_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "&Save", IDM_FILE_SAVE
        MENUITEM "Save &As...", IDM_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&Extract"
    BEGIN
        MENUITEM "Extract &Selected...", IDM_EXTRACT_SELECTED
        MENUITEM "Extract &Shown...", IDM_EXTRACT_SHOWN
    END
    POPUP "&Import"
    BEGIN
        MENUITEM "Import &File...", IDM_IMPORT_FILE
        MENUITEM "Import F&older...", IDM_IMPORT_FOLDER
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Delete Entry", IDM_DELETE_ENTRY
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Server Configuration...", IDM_TOOLS_SERVER_CONFIG
        MENUITEM "&Defragment / Optimize PK2...", IDM_TOOLS_DEFRAGMENT
        MENUITEM "Private-server MD&5 Helper", IDM_HELP_MD5
        MENUITEM SEPARATOR
        MENUITEM "&About PK2 Workbench PRO", IDM_HELP_ABOUT
    END
END

IDD_SERVER_CONFIG DIALOGEX 0, 0, 390, 247
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Server Configuration"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Content ID:", -1, 8, 12, 48, 10
    EDITTEXT IDC_CONTENT_ID, 58, 10, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Version:", -1, 116, 12, 38, 10
    EDITTEXT IDC_SERVER_VERSION, 156, 10, 58, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Gateway port:", -1, 236, 12, 60, 10
    EDITTEXT IDC_GATEWAY_PORT, 299, 10, 58, 14, ES_NUMBER | ES_AUTOHSCROLL

    GROUPBOX "Divisions", -1, 8, 34, 181, 173
    LISTBOX IDC_DIVISION_LIST, 16, 48, 165, 76, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT "Division name:", -1, 16, 132, 62, 10
    EDITTEXT IDC_DIVISION_NAME, 16, 144, 165, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Add", IDC_DIVISION_ADD, 16, 166, 46, 15
    PUSHBUTTON "Update", IDC_DIVISION_UPDATE, 67, 166, 52, 15
    PUSHBUTTON "Remove", IDC_DIVISION_REMOVE, 124, 166, 57, 15

    GROUPBOX "Gateway URLs", -1, 198, 34, 184, 173
    LISTBOX IDC_GATEWAY_LIST, 206, 48, 168, 76, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT "IP address or host name:", -1, 206, 132, 104, 10
    EDITTEXT IDC_GATEWAY_URL, 206, 144, 168, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Add", IDC_GATEWAY_ADD, 206, 166, 46, 15
    PUSHBUTTON "Update", IDC_GATEWAY_UPDATE, 257, 166, 52, 15
    PUSHBUTTON "Remove", IDC_GATEWAY_REMOVE, 314, 166, 60, 15

    LTEXT "Applying changes updates and saves the open Media.pk2 automatically.", -1, 8, 216, 275, 10
    DEFPUSHBUTTON "Apply && Save", IDOK, 275, 226, 57, 14
    PUSHBUTTON "Cancel", IDCANCEL, 337, 226, 45, 14
END

IDD_PASSWORD DIALOGEX 0, 0, 235, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PK2 Password"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Password:", -1, 8, 12, 48, 10
    EDITTEXT IDC_PASSWORD_EDIT, 62, 10, 164, 14, ES_AUTOHSCROLL
    CONTROL "Use official SRO default (169841)", IDC_DEFAULT_PASSWORD, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 62, 31, 150, 10
    DEFPUSHBUTTON "OK", IDOK, 126, 58, 45, 14
    PUSHBUTTON "Cancel", IDCANCEL, 181, 58, 45, 14
END

IDD_TEXT_EDITOR DIALOGEX 0, 0, 620, 410
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Text File"
FONT 9, "Consolas"
BEGIN
    EDITTEXT IDC_TEXT_EDIT, 7, 7, 606, 370,
             ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN |
             WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Save", IDOK, 514, 386, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 565, 386, 48, 16
END

IDR_ACCELERATOR ACCELERATORS
BEGIN
    "O",            IDM_FILE_OPEN,          VIRTKEY, CONTROL
    "S",            IDM_FILE_SAVE,          VIRTKEY, CONTROL
    "S",            IDM_FILE_SAVE_AS,       VIRTKEY, CONTROL, SHIFT
    "F",            IDM_FOCUS_SEARCH,       VIRTKEY, CONTROL
    VK_F5,          IDM_VIEW_REFRESH,       VIRTKEY
    VK_DELETE,      IDM_DELETE_ENTRY,       VIRTKEY
END
